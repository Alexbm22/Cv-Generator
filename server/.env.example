# Copy to server/.env. Replace every change-me value before running in production.
NODE_ENV=development
PORT=3001
ORIGIN=http://localhost:5173

# Set both to serve HTTPS directly; leave unset behind a TLS-terminating proxy.
# SSL_KEY_PATH=
# SSL_CERT_PATH=

RATE_LIMIT_DEFAULT_WINDOW_MS=900000
RATE_LIMIT_DEFAULT_LIMIT=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_LIMIT=20
RATE_LIMIT_REFRESH_TOKEN_WINDOW_MS=900000
RATE_LIMIT_REFRESH_TOKEN_LIMIT=60
RATE_LIMIT_CHECK_AUTH_WINDOW_MS=900000
RATE_LIMIT_CHECK_AUTH_LIMIT=60
RATE_LIMIT_CVS_WINDOW_MS=900000
RATE_LIMIT_CVS_LIMIT=100

# At least 32 characters each, and different from each other.
JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_REFRESH_SECRET=change-me-to-a-different-32-plus-character-value
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=cvgenapp
DB_DIALECT=postgres

# 64 hex characters (32 bytes), e.g. openssl rand -hex 32
ENCRYPTION_KEY=

AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_ID_SALT=change-me-to-a-random-salt

# Production requires sk_live_ or rk_live_ keys.
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
OPENAI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=CVGenApp Team
EMAIL_DOMAIN=cvgenapp.com

PASSWORD_ACTION_TOKEN_TTL_MIN=20
PASSWORD_ACTION_SESSION_TTL_MIN=15
PASSWORD_ACTION_COOKIE_NAME=password_action_session
PASSWORD_ACTION_COOKIE_PATH=/api/password
PASSWORD_ACTION_LOG_LINKS=false

PASSWORD_ARGON2_MEMORY_COST=19456
PASSWORD_ARGON2_TIME_COST=2
PASSWORD_ARGON2_PARALLELISM=1
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=128
